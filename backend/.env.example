# ============================================================
#  Hermes ICP Radar — .env EXEMPLO
#  Copie para .env e preencha os valores.
#  NUNCA commite .env com valores reais!
# ============================================================

# ── Ambiente ─────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Autenticacao ─────────────────────────────────────────────
HERMES_AUTH_REQUIRED=false
HERMES_MASTER_EMAIL=

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
SUPABASE_JWT_SECRET=seu_jwt_secret_aqui
SUPABASE_JWT_ISSUER=supabase
SUPABASE_JWT_AUDIENCE=authenticated

# ── Multi-tenant: roteamento de destino Supabase (por X-Org-Id) ───────────────
# Formato JSON:
# {
#   "default": { "url": "https://xxx.supabase.co", "service_role_key": "....", "n8n_outbound_webhook": "https://n8n.../webhook/...", "n8n_kommo_webhook": "https://n8n.../webhook/..." },
#   "quitoubr": { "url": "https://yyy.supabase.co", "service_role_key": "....", "n8n_outbound_webhook": "https://n8n.../webhook/...", "n8n_kommo_webhook": "https://n8n.../webhook/..." }
# }
SUPABASE_TENANTS_JSON=

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=gerar_com_openssl_rand_hex_32

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# ── DuckDB ───────────────────────────────────────────────────
HERMES_DUCKDB_PATH=
HERMES_APP_DB_PATH=

# ── PGFN / Quitou BR (prospecção só com dívida em aberto; alinhar com VITE_DEFAULT_ORG_ID) ──
HERMES_PROSPECCAO_PGFN_ORG_IDS=451d43bd-da3f-4709-9473-71721e7a55bf
HERMES_PG_PUBLIC_SNAPSHOT_ORG_ID=default
# Multiplicador de busca na Receita antes de filtrar pela PGFN (padrão 25)
# HERMES_PROSPECCAO_PGFN_PREFETCH_MULTIPLIER=25
# Substrings em situacao (PGFN) que indicam dívida encerrada — exclui da seleção
# HERMES_PG_PUBLIC_FISCAL_SITUACAO_FECHADA_SUBSTR=quit,baix,exclu,pago,cancel,anul

# ── APIs de prospeccao ───────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SEARXNG_URL=http://127.0.0.1:8888
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev
FIRECRAWL_PROXY=basic
SEARCH_PROVIDER_ORDER=google,searxng,tavily,brave,bing,ddgs
APOLLO_API_KEY=
HUNTER_API_KEY=
SNOVIO_USER_ID=
SNOVIO_SECRET=
PROXYCURL_API_KEY=

# ── Pagamentos (Asaas) ──────────────────────────────────────
ASAAS_API_KEY=sua_chave_asaas_aqui
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=gerar_com_openssl_rand_hex_32

# ── Ploomes CRM ─────────────────────────────────────────────
PLOOMES_API_KEY=sua_user_key_do_ploomes
PLOOMES_FUNNEL_ID=

# ── Kommo — funil padrão para export de leads (quando org_integrations não define)
# Ex.: https://bfcompanypinn.kommo.com/leads/pipeline/13230435/
# Se KOMMO_DEFAULT_SUBDOMAIN estiver vazio, o funil abaixo vale para qualquer subdomínio informado no modal.
KOMMO_DEFAULT_SUBDOMAIN=bfcompanypinn
KOMMO_DEFAULT_PIPELINE_ID=13230435
KOMMO_DEFAULT_STATUS_ID=

# ── n8n SDR Integration ─────────────────────────────────────
N8N_SDR_API_KEY=gerar_com_openssl_rand_hex_32
N8N_OUTBOUND_WEBHOOK=https://n8n.srv879715.hstgr.cloud/webhook/hermes-outbound
AUTO_SEND_SDR_ON_PIPELINE_ADD=false
AUTO_PIPELINE_AND_SDR_AFTER_PROSPECCAO=false

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
