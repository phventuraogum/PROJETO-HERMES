# Referência apenas — variáveis NÃO secretas (UUIDs, URLs públicas).
# Copie trechos para .env / .env.production conforme o ambiente.
# Nunca coloque aqui chaves JWT, service role, ou passwords.

# --- Frontend (Vite) — build Quitou BR ---
# Alinhar com HERMES_PROSPECCAO_PGFN_ORG_IDS no backend (public.organizations.id).
VITE_DEFAULT_ORG_ID=451d43bd-da3f-4709-9473-71721e7a55bf
# URL pública da API (ajuste se usar HTTPS ou domínio próprio)
VITE_API_BASE_URL=http://srv887957.hstgr.cloud

# --- Backend — mesmo repositório /opt/hermes/.env na VPS ---
HERMES_PROSPECCAO_PGFN_ORG_IDS=451d43bd-da3f-4709-9473-71721e7a55bf
# Deve ser o org_id onde foi importado o snapshot PGFN (ver scripts/verify_pgfn_prod.sh)
HERMES_PG_PUBLIC_SNAPSHOT_ORG_ID=default
